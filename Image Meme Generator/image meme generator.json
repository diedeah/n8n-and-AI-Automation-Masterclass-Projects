      "parameters": {
        "promptType": "define",
        "text": "=User input:{{ $('When chat message received').item.json.chatInput }}\n\nAvailable meme template:\n{{ $json.list }}\n",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are a meme generator. Pick the ONE template from the list that best fits the user's idea.\nCopy the template name EXACTLY as written in the list. Never invent a name.\nIf the idea asks for a template that isn't listed, choose the closest one.\nWrite short, funny text for text0 (top) and text1 (bottom).\nReturn only the structured output."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        0
      ],
      "id": "b57d8044-6f28-47d0-802f-00cda7554306",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "const out = $input.first().json.output;\nconst memes = $('Filter Templates').first().json.memes;\nconst norm = s => String(s || '').toLowerCase().trim();\n\nlet match =\n  memes.find(m => norm(m.name) === norm(out.template_name)) ||\n  memes.find(m => norm(m.name).includes(norm(out.template_name)) ||\n                  norm(out.template_name).includes(norm(m.name)));\n\nif (!match) match = memes.find(m => m.name === 'Drake Hotline Bling'); // fallback\n\nreturn [{ json: {\n  template_id: match.id,\n  template_name: match.name,\n  text0: out.text0,\n  text1: out.text1\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        0
      ],
      "id": "e01065b6-5252-440d-b933-7dd97ce9d266",
      "name": "Lookup Template"
    },
    {
      "parameters": {
        "jsCode": "const memes = $input.first().json.data.memes\n  .filter(m => m.box_count === 2)   // only 2-box templates, since you use text0/text1\n  .map(m => ({ id: m.id, name: m.name }));\n\nreturn [{ json: { memes, list: memes.map(m => m.name).join('\\n') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
